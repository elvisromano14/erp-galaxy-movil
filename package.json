{
  "name": "erp-galaxy-movil",
  "version": "0.1.1",
  "private": true,
  "description": "App móvil (Android) de vendedores del Mini ERP: productos, clientes, cotizaciones y pedidos, offline-first.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathIgnorePatterns integration",
    "contracts:sync": "node scripts/sync-erp-contracts.mjs",
    "contracts:check": "node scripts/sync-erp-contracts.mjs --check",
    "db:generate": "drizzle-kit generate",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:int": "jest -c jest.int.config.js"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.0.2",
    "babel-preset-expo": "~57.0.14",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~57.0.27",
    "expo-background-task": "~57.0.21",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.18",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "^57.0.5",
    "typescript": "~6.0.3"
  }
}
